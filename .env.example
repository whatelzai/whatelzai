# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: override origin used in OAuth discovery metadata
# NEXT_PUBLIC_MCP_BASE_URL=https://your-website.com

# Command Center — cross-product owner-metrics for /admin/command-center.
# Each remote product exposes GET /api/internal/owner-metrics gated by its
# own OWNER_METRICS_TOKEN. Leave any pair unset to render its widget as
# 'pending'. Origins default to production; override for staging.
EMDEE_ORIGIN=https://emdee.tech
EMDEE_OWNER_METRICS_TOKEN=

# Authentication uses Supabase Auth. Configure Google OAuth in Supabase,
# including each /auth/callback URL in the redirect allowlist.
# Google client secrets belong in Supabase, never NEXT_PUBLIC_* variables.

# Email delivery — Resend (get from resend.com/api-keys)
RESEND_API_KEY=re_your-resend-api-key

# Stripe — subscription billing (dashboard.stripe.com/apikeys)
# Product/Price catalog lives in Supabase `stripe_offers`; only secrets belong here.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
# Webhook signing secret — from `stripe listen` (local) or dashboard webhook endpoint (prod).
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
# Optional — used to build absolute checkout success/cancel URLs. Defaults to https://whatelz.ai.
# NEXT_PUBLIC_SITE_URL=https://whatelz.ai

# Sole administrator: stable public.users.id, never an email or Supabase Auth ID.
# Required on every deployment. Missing/invalid configuration denies administration.
WHATELZ_OWNER_USER_ID=

# Private daily connections: 32 random bytes encoded as 64 lowercase hex chars.
# Keep independent of the database; changing it makes stored credentials unreadable.
# EMDEE authorization and the chosen OpenAI key/model are configured through
# the owner-only /today/connections UI, never committed or copied from chat tokens.
DAILY_INTEGRATION_KEY=

# Production-only Vercel cron bearer credential. Generate independently of other keys.
# Required for production saved-routine push checks and the API-gated legacy weekly job; never NEXT_PUBLIC_.
CRON_SECRET=

# Opt in explicitly to personal API generation. Defaults off, including weekly cron.
# ChatGPT scheduled tasks write directly to EMDEE without this flag.
DAILY_API_GENERATION_ENABLED=false

# Member API assistant only, on app.whatelz.ai. Independent of personal Daily.
# Uses the owner-configured encrypted OpenAI provider connection server-side.
MEMBER_AI_ENABLED=false

# Admin Web Push signing keys (independent from AI/provider credentials).
# Keep the private key a Vercel Production Secret. Public key is returned only
# by the authenticated Admin settings endpoint. Use separate local/preview keys.
ADMIN_PUSH_PUBLIC_KEY=
ADMIN_PUSH_PRIVATE_KEY=

# First-party event signup. Enable only after production Checkout Sessions write
# permission, promo seeding, expiry webhook and legacy-checkout cutover are verified.
EVENT_PLATFORM_REGISTRATION_ENABLED=false
